{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/workbench.mjs\" context",
            "timeout": 20,
            "statusMessage": "Reading Workbench task context",
            "additionalContextLimit": 6000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/workbench.mjs\" context --hook UserPromptSubmit",
            "timeout": 20,
            "statusMessage": "Reading Workbench task context",
            "additionalContextLimit": 6000
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/workbench.mjs\" context --hook SubagentStart",
            "timeout": 20,
            "statusMessage": "Reading Workbench task context",
            "additionalContextLimit": 6000
          }
        ]
      }
    ]
  }
}
